<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rendering="using:WSnip.App.Rendering"
             xmlns:strings="using:WSnip.Core.Strings"
             x:Class="WSnip.App.Editor.ColorEditor"
             Width="320">


    <StackPanel Spacing="16">
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <rendering:ColorSwatch x:Name="Preview" Width="48" Height="48" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid ColumnSpacing="12" RowSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock x:Name="GamutLabel" Text="{x:Bind strings:AppStrings.ColorSpace, Mode=OneTime}" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" />
            <ComboBox x:Name="GamutBox" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Bind strings:AppStrings.ColorSpace, Mode=OneTime}" />

            <TextBlock Grid.Row="1" Text="{x:Bind strings:AppStrings.Hex, Mode=OneTime}" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" />
            <TextBox x:Name="HexBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" MaxLength="7" AutomationProperties.Name="{x:Bind strings:AppStrings.Hex, Mode=OneTime}" />

            <TextBlock Grid.Row="2" Text="{x:Bind strings:AppStrings.Red, Mode=OneTime}" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" />
            <Slider x:Name="RedSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" AutomationProperties.Name="{x:Bind strings:AppStrings.Red, Mode=OneTime}" />
            <TextBlock x:Name="RedText" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}" />

            <TextBlock Grid.Row="3" Text="{x:Bind strings:AppStrings.Green, Mode=OneTime}" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" />
            <Slider x:Name="GreenSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="255" AutomationProperties.Name="{x:Bind strings:AppStrings.Green, Mode=OneTime}" />
            <TextBlock x:Name="GreenText" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}" />

            <TextBlock Grid.Row="4" Text="{x:Bind strings:AppStrings.Blue, Mode=OneTime}" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" />
            <Slider x:Name="BlueSlider" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="255" AutomationProperties.Name="{x:Bind strings:AppStrings.Blue, Mode=OneTime}" />
            <TextBlock x:Name="BlueText" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}" />

            <TextBlock x:Name="BrightnessLabel" Grid.Row="5" Text="{x:Bind strings:AppStrings.Brightness, Mode=OneTime}" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}"
                       ToolTipService.ToolTip="{x:Bind strings:AppStrings.BrightnessTip, Mode=OneTime}" />
            <Slider x:Name="BrightnessSlider" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="4" SmallChange="0.1" LargeChange="1" AutomationProperties.Name="{x:Bind strings:AppStrings.Brightness, Mode=OneTime}" />
            <TextBlock x:Name="BrightnessText" Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}" />
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" MinWidth="88" HorizontalContentAlignment="Center"
                    Content="{x:Bind strings:AppStrings.Cancel, Mode=OneTime}" />
            <Button x:Name="ApplyButton" Style="{StaticResource AccentButtonStyle}" MinWidth="88" Content="{x:Bind strings:AppStrings.Add, Mode=OneTime}" />
        </StackPanel>
    </StackPanel>
</UserControl>
