<services:AppWindowBase xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="using:WSnip.App.Services" xmlns:settings="using:WSnip.App.Settings" xmlns:strings="using:WSnip.Core.Strings" x:Class="WSnip.App.Editor.ToneMappingWindow">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,10,16,16">
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind strings:AppStrings.ShowToneMapped, Mode=OneTime}" />
                    <TextBlock x:Name="ShowToneMappedCaption" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                               Text="{x:Bind strings:AppStrings.ShowToneMappedCaption, Mode=OneTime}" />
                </StackPanel>
                <ToggleSwitch x:Name="ShowToneMappedSwitch" Grid.Column="1" OnContent="" OffContent="" IsOn="True"
                              AutomationProperties.Name="{x:Bind strings:AppStrings.ShowToneMapped, Mode=OneTime}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <StackPanel Spacing="6">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind strings:AppStrings.ToneMappingMode, Mode=OneTime}" VerticalAlignment="Center" />
                    <ComboBox x:Name="ScopeBox" Grid.Column="1" Width="210" VerticalAlignment="Center"
                              AutomationProperties.Name="{x:Bind strings:AppStrings.ToneMappingMode, Mode=OneTime}" />
                </Grid>
                <TextBlock x:Name="ScopeInfo" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <UserControl x:Name="CurveRow" Padding="14,12" Margin="0,0,0,4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="6">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind strings:AppStrings.ToneCurve, Mode=OneTime}" VerticalAlignment="Center" />
                    <ComboBox x:Name="CurveBox" Grid.Column="1" Width="210" VerticalAlignment="Center"
                              AutomationProperties.Name="{x:Bind strings:AppStrings.ToneCurve, Mode=OneTime}" />
                </Grid>
                <TextBlock x:Name="CurveInfo" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                <StackPanel x:Name="ParameterRows" Spacing="4" Margin="0,6,0,0" />
                <Button x:Name="ResetButton" HorizontalAlignment="Right"
                        Content="{x:Bind strings:AppStrings.ResetToDefaults, Mode=OneTime}" />
            </StackPanel>
        </UserControl>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind strings:AppStrings.SetAsDefault, Mode=OneTime}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Text="{x:Bind strings:AppStrings.SetAsDefaultCaption, Mode=OneTime}" />
                </StackPanel>
                <ToggleSwitch x:Name="DefaultSwitch" Grid.Column="1" OnContent="" OffContent=""
                              AutomationProperties.Name="{x:Bind strings:AppStrings.SetAsDefault, Mode=OneTime}" />
            </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
            <Button x:Name="SaveButton" Style="{StaticResource AccentButtonStyle}" MinWidth="88" HorizontalContentAlignment="Center"
                    Content="{x:Bind strings:AppStrings.Save, Mode=OneTime}" />
            <Button x:Name="CancelButton" MinWidth="88" HorizontalContentAlignment="Center"
                    Content="{x:Bind strings:AppStrings.Cancel, Mode=OneTime}" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</services:AppWindowBase>
