<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:strings="using:WSnip.Core.Strings"
             x:Class="WSnip.App.Settings.HotkeyRow">
    <Border Style="{StaticResource SettingRowStyle}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" />
                <TextBlock x:Name="InfoText" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel x:Name="Editor" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="PrintScreenButton" Content="{x:Bind strings:AppStrings.PrintScreen, Mode=OneTime}" ToolTipService.ToolTip="{x:Bind strings:AppStrings.PrintScreenTip, Mode=OneTime}" />
                <TextBox x:Name="GestureBox" Width="114" IsReadOnly="True" PlaceholderText="{x:Bind strings:AppStrings.None, Mode=OneTime}" />
                <Button x:Name="ClearButton" ToolTipService.ToolTip="{x:Bind strings:AppStrings.NoShortcut, Mode=OneTime}" AutomationProperties.Name="{x:Bind strings:AppStrings.NoShortcut, Mode=OneTime}">
                    <SymbolIcon Symbol="Clear" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
