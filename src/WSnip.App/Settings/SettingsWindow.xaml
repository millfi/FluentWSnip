<services:AppWindowBase xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="using:WSnip.App.Services" xmlns:settings="using:WSnip.App.Settings" xmlns:strings="using:WSnip.Core.Strings" x:Class="WSnip.App.Settings.SettingsWindow">
    <ScrollViewer>
        <StackPanel Margin="24,12,24,24">
            <TextBlock Text="{x:Bind strings:AppStrings.Settings, Mode=OneTime}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,4" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Bind strings:AppStrings.Startup, Mode=OneTime}" />
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind strings:AppStrings.StartWindows, Mode=OneTime}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind strings:AppStrings.StartupCaption, Mode=OneTime}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StartupSwitch" Grid.Column="1" OnContent="" OffContent="" AutomationProperties.Name="{x:Bind strings:AppStrings.StartWindows, Mode=OneTime}" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Bind strings:AppStrings.TakingSnips, Mode=OneTime}" />
            <Border x:Name="ScreenClippingRow" Style="{StaticResource SettingRowStyle}" Visibility="Collapsed">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind strings:AppStrings.WindowsScreenshotShortcut, Mode=OneTime}" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <Button x:Name="ScreenClippingButton" Grid.Column="1" Content="{x:Bind strings:AppStrings.ChooseDefaultApp, Mode=OneTime}" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <settings:HotkeyRow x:Name="DefaultHotkeyRow" Title="{x:Bind strings:AppStrings.Shortcut, Mode=OneTime}"
                                Caption="{x:Bind strings:AppStrings.DefaultShortcutCaption, Mode=OneTime}" />
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind strings:AppStrings.SnippingMode, Mode=OneTime}" VerticalAlignment="Center" />
                    <ComboBox x:Name="ModeBox" Grid.Column="1" Width="150" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind strings:AppStrings.SnippingMode, Mode=OneTime}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind strings:AppStrings.Delay, Mode=OneTime}" VerticalAlignment="Center" />
                    <ComboBox x:Name="DelayBox" Grid.Column="1" Width="150" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind strings:AppStrings.Delay, Mode=OneTime}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind strings:AppStrings.IncludeCursor, Mode=OneTime}" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="CursorSwitch" Grid.Column="1" OnContent="" OffContent="" AutomationProperties.Name="{x:Bind strings:AppStrings.IncludeCursor, Mode=OneTime}" />
                </Grid>
            </Border>

            <StackPanel x:Name="ModeHotkeySection">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Bind strings:AppStrings.ModeShortcuts, Mode=OneTime}" />
                <StackPanel x:Name="ModeHotkeyRows" />
            </StackPanel>

            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Bind strings:AppStrings.AfterSnip, Mode=OneTime}" />
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind strings:AppStrings.CopyClipboard, Mode=OneTime}" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="CopySwitch" Grid.Column="1" OnContent="" OffContent="" AutomationProperties.Name="{x:Bind strings:AppStrings.CopyClipboard, Mode=OneTime}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind strings:AppStrings.OpenEditor, Mode=OneTime}" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="EditorSwitch" Grid.Column="1" OnContent="" OffContent="" AutomationProperties.Name="{x:Bind strings:AppStrings.OpenEditor, Mode=OneTime}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind strings:AppStrings.ShowPixelInfo, Mode=OneTime}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                                   Text="{x:Bind strings:AppStrings.PixelInfoCaption, Mode=OneTime}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="PixelInfoSwitch" Grid.Column="1" OnContent="" OffContent="" AutomationProperties.Name="{x:Bind strings:AppStrings.ShowPixelInfo, Mode=OneTime}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind strings:AppStrings.AutoSave, Mode=OneTime}" />
                        <TextBlock x:Name="FolderText" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="FolderButton" Content="{x:Bind strings:AppStrings.ChangeFolder, Mode=OneTime}" />
                        <ToggleSwitch x:Name="AutoSaveSwitch" OnContent="" OffContent="" AutomationProperties.Name="{x:Bind strings:AppStrings.AutoSave, Mode=OneTime}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Bind strings:AppStrings.Files, Mode=OneTime}" />
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind strings:AppStrings.SdrFormat, Mode=OneTime}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Text="{x:Bind strings:AppStrings.SdrFormatCaption, Mode=OneTime}" />
                    </StackPanel>
                    <ComboBox x:Name="SdrFormatBox" Grid.Column="1" Width="150" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind strings:AppStrings.SdrFormat, Mode=OneTime}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind strings:AppStrings.HdrFormat, Mode=OneTime}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Text="{x:Bind strings:AppStrings.HdrFormatCaption, Mode=OneTime}" />
                    </StackPanel>
                    <ComboBox x:Name="HdrFormatBox" Grid.Column="1" Width="150" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind strings:AppStrings.HdrFormat, Mode=OneTime}" />
                </Grid>
            </Border>
            <TextBlock x:Name="CodecWarning" Style="{StaticResource CaptionStyle}" Margin="14,2,14,10"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       Text="{x:Bind strings:AppStrings.SystemCodecWarning, Mode=OneTime}" />
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind strings:AppStrings.Quality, Mode=OneTime}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind strings:AppStrings.QualityCaption, Mode=OneTime}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Slider x:Name="QualitySlider" Width="114" Minimum="50" Maximum="100" TickFrequency="1" IsThumbToolTipEnabled="True" AutomationProperties.Name="{x:Bind strings:AppStrings.Quality, Mode=OneTime}" />
                        <TextBlock x:Name="QualityText" Width="28" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind strings:AppStrings.SdrVersion, Mode=OneTime}" />
                        <TextBlock x:Name="ToneMappingInfo" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="ToneMappingBox" Grid.Column="1" Width="150" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind strings:AppStrings.SdrVersion, Mode=OneTime}" />
                </Grid>
            </Border>
            <Border x:Name="ToneCurveRow" Style="{StaticResource SettingRowStyle}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind strings:AppStrings.ToneCurve, Mode=OneTime}" />
                        <TextBlock x:Name="ToneCurveInfo" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="ToneCurveBox" Grid.Column="1" Width="150" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind strings:AppStrings.ToneCurve, Mode=OneTime}" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Bind strings:AppStrings.Appearance, Mode=OneTime}" />
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind strings:AppStrings.Theme, Mode=OneTime}" VerticalAlignment="Center" />
                    <ComboBox x:Name="ThemeBox" Grid.Column="1" Width="150" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind strings:AppStrings.Theme, Mode=OneTime}" />
                </Grid>
            </Border>
            <Border x:Name="MicaRow" Style="{StaticResource SettingRowStyle}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind strings:AppStrings.Mica, Mode=OneTime}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind strings:AppStrings.MicaCaption, Mode=OneTime}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="MicaSwitch" Grid.Column="1" OnContent="" OffContent="" AutomationProperties.Name="{x:Bind strings:AppStrings.Mica, Mode=OneTime}" />
                </Grid>
            </Border>

            <TextBlock x:Name="AboutText" Style="{StaticResource CaptionStyle}" Margin="2,20,2,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</services:AppWindowBase>
