<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>FluentWSnip</AssemblyName>
    <RootNamespace>WSnip.App</RootNamespace>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\wsnip.ico</ApplicationIcon>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Platform Condition="'$(Platform)' == 'AnyCPU' and '$(RuntimeIdentifier)' == 'win-arm64'">ARM64</Platform>
    <Platform Condition="'$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Framework-dependent: the shared .NET Desktop Runtime and the Windows App Runtime framework
         package replace the bundled runtimes, keeping the MSIX payload small. -->
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="LightStudio.Ffmpeg" />
    <ProjectReference Include="..\WSnip.Core\WSnip.Core.csproj" />
    <ProjectReference Include="..\WSnip.Windows\WSnip.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\tests\Fixtures\PresentationFixture.cs" Link="Rendering\PresentationFixture.cs" Condition="'$(Configuration)' == 'Debug'" />
    <Content Include="Assets\wsnip.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\packaging\WSnipMSIX\Images\*.png" Link="Images\%(Filename)%(Extension)" />
    <PRIResource Include="..\..\packaging\WSnipMSIX\Resources.resw" Link="Resources.resw" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
  <Target Name="RequireWindowsArchitecture" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)' != 'x64' and '$(Platform)' != 'ARM64'" Text="Build FluentWSnip with -p:Platform=x64 or -p:Platform=ARM64." />
  </Target>
</Project>
