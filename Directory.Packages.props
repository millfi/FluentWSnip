<Project>
  <Import Project="$(LightPlayerRoot)Directory.Packages.props" />
  <ItemGroup>
    <PackageVersion Update="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageVersion Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer" Version="0.8.0" />
  </ItemGroup>
  <ItemGroup>
    <GitHubNuGetAsset Remove="@(GitHubNuGetAsset)" Condition="!$([System.String]::Copy('%(Identity)').StartsWith('LightStudio.Ffmpeg.'))" />
  </ItemGroup>
</Project>
