<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InstallerArchitecture Condition="'$(InstallerArchitecture)' == ''">x64</InstallerArchitecture>
    <InstallerPlatform>$(InstallerArchitecture)</InstallerPlatform>
    <PackageUpgradeCode>4724920f-0ee8-4e65-a62c-aa34110f8a3c</PackageUpgradeCode>
    <MsiVersion Condition="'$(MsiVersion)' == ''">0.1.0</MsiVersion>
    <PublishDirectory Condition="'$(PublishDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\fluent-windows-installer\$(InstallerArchitecture)\publish</PublishDirectory>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\fluent-windows-installer\$(InstallerArchitecture)\msi\</OutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\obj\FluentWSnipSetup\package\$(InstallerArchitecture)\</IntermediateOutputPath>
    <OutputName>FluentWSnip-$(InstallerArchitecture)</OutputName>
    <DefaultCompressionLevel>high</DefaultCompressionLevel>
    <!-- ICE03 rejects the WinUI DLLs' long language lists and valid ug-CN/mi-NZ/gd-GB MUI IDs.
         Keep the SDK binaries intact. ICE09/32 require VBScript; ICE61 flags intentional same-version upgrades. -->
    <SuppressIces>$(SuppressIces);ICE03;ICE09;ICE32;ICE61</SuppressIces>
    <DefineConstants>$(DefineConstants);MsiVersion=$(MsiVersion);PackageUpgradeCode=$(PackageUpgradeCode);PublishDirectory=$(PublishDirectory);IconPath=$(MSBuildThisFileDirectory)..\..\src\WSnip.App\Assets\wsnip.ico;LicensePath=$(MSBuildThisFileDirectory)..\..\LICENSE;ThirdPartyPath=$(MSBuildThisFileDirectory)..\..\THIRDPARTY.txt</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Package.wxs" />
  </ItemGroup>
</Project>
