<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <WindowsTargetVersion>windows10.0.26100.0</WindowsTargetVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64;ARM64</Platforms>
    <Configurations>Debug;Release</Configurations>
    <BuildInParallel>false</BuildInParallel>
    <Version>0.1.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Company>Light Studio</Company>
    <Product>FluentWSnip</Product>
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
    <!-- Keep the original WSnip development package layout untouched. -->
    <ArtifactsProjectName Condition="'$(MSBuildProjectName)' == 'WSnip.App'">FluentWSnip</ArtifactsProjectName>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <!-- Shared Light Player sources and build scripts. -->
    <LightPlayerRoot Condition="'$(LightPlayerRoot)' == ''">$(MSBuildThisFileDirectory)..\LightPlayer\</LightPlayerRoot>
    <LightPlayerRoot Condition="!Exists('$(LightPlayerRoot)Directory.Packages.props') and Exists('$(MSBuildThisFileDirectory).deps/LightPlayer/Directory.Packages.props')">$(MSBuildThisFileDirectory).deps/LightPlayer/</LightPlayerRoot>
    <UseAvaloniaFork>false</UseAvaloniaFork>
    <NativeBindingsPolicy>$(LightPlayerRoot)build/NativeBindings.Configuration.targets</NativeBindingsPolicy>
  </PropertyGroup>

  <Import Project="$(LightPlayerRoot)tools/NativeBindings/NativeBindings.props" />

  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <DebuggerSupport>false</DebuggerSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>
    <OptimizationPreference>Speed</OptimizationPreference>
    <EventSourceSupport>false</EventSourceSupport>
  </PropertyGroup>
</Project>
